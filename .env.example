# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/dental_crm"

# Authentication (NextAuth)
NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:3000"

# Clinic
CLINIC_NAME="Smile Studio Dental"
CLINIC_TIMEZONE="Asia/Kolkata"
CLINIC_PHONE="+910000000000"
CLINIC_ADDRESS="12 MG Road, Kochi"

# Shared secret the voice agent (Vapi / Retell) sends in the `x-voice-secret` header
VOICE_TOOL_SECRET="change-me"

# Shared secret for the reminder cron endpoint (`Authorization: Bearer <secret>`)
CRON_SECRET="change-me"

# Anthropic (optional - without it, reminders use template text instead of AI-personalised messages)
ANTHROPIC_API_KEY=""

# Twilio (optional - without it, reminders are simulated and logged)
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_SMS_FROM=""
TWILIO_WHATSAPP_FROM=""
